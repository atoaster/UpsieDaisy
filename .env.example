# Copy this file to `.env` (which is gitignored) and fill in your own values.
# NEVER commit a real token to this repository.

# Your personal Up API token, created at https://api.up.com.au/getting_started
# Leave blank if you prefer to enter the token in the web UI instead
# (it is then stored only in your browser's localStorage and sent per-request).
UP_API_TOKEN=

# Port for the UpsieDaisy API server
PORT=3001

# Set to 1 to run with synthetic demo data (no bank token required)
UPSIE_DEMO=
